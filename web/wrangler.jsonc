{
  // One Worker, static assets only (ADR-0016): the built client and the files
  // `forecast.export` wrote into `public/data/`. No Worker code runs, so every
  // request is a static asset, which is free and unmetered.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cz-epf",
  "compatibility_date": "2026-09-01",
  "assets": {
    // `pnpm --filter @cz-epf/web build` writes it, after the export.
    "directory": "./dist",
  },
  // Pull requests upload versions with public URLs on workers.dev (ADR-0010).
  "workers_dev": true,
  "preview_urls": true,
}
